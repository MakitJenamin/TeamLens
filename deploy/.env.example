# Cấu hình TeamLens production. Sao chép thành deploy/.env rồi sửa (xem deploy/README.md).

# Tên miền trỏ về máy chủ này; Caddy tự xin HTTPS cho tên miền. Thử trên máy: localhost.
TEAMLENS_DOMAIN=teamlens.congty.com
# Địa chỉ người dùng mở trong trình duyệt và dùng trong link mời. Mặc định https://<TEAMLENS_DOMAIN>.
# TEAMLENS_PUBLIC_URL=https://teamlens.congty.com

# Mật khẩu Postgres (chỉ dùng trong mạng nội bộ của compose). Sinh: openssl rand -hex 24
POSTGRES_PASSWORD=

# 32 byte base64, dùng mã hóa API key AI của từng người (AES-GCM). Sinh: openssl rand -base64 32
# Giữ bí mật và sao lưu cùng DB: mất khóa này thì mọi người phải nhập lại API key AI.
TEAMLENS_SECRET_KEY=

# Phiên bản tl tối thiểu; CLI cũ hơn ngừng gửi và báo cần cập nhật.
# MIN_CLI_VERSION=0.1.0

# Đổi cổng nếu 80/443 đã bận (khi đó Let's Encrypt không cấp được chứng chỉ, chỉ dùng khi thử).
# HTTP_PORT=80
# HTTPS_PORT=443
