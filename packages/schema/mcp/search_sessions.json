{
  "name": "search_sessions",
  "description": "Tìm và liệt kê session của một project, mới nhất trước, có phân trang. Lọc theo người, agent, khoảng ngày, từ khóa trong nội dung (full-text, cú pháp kiểu web search). Member chỉ thấy session của mình; leader thấy mọi session. Kết quả gồm `nextCursor` (null khi hết); truyền lại làm `cursor` để lấy trang kế.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "projectId"
    ],
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "format": "uuid",
        "description": "Project cần tìm."
      },
      "userId": {
        "type": "string",
        "format": "uuid",
        "description": "Chỉ session của người này (member chỉ được đặt chính mình)."
      },
      "agent": {
        "type": "string",
        "enum": [
          "claude_code",
          "codex",
          "copilot_vscode",
          "antigravity"
        ],
        "description": "Chỉ session của agent này."
      },
      "from": {
        "type": "string",
        "format": "date-time",
        "description": "Chỉ session bắt đầu từ mốc này (ISO 8601)."
      },
      "to": {
        "type": "string",
        "format": "date-time",
        "description": "Chỉ session bắt đầu trước mốc này."
      },
      "q": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "Từ khóa trong nội dung session (full-text). Nội dung prompt, không đưa thông tin nhạy cảm."
      },
      "includeSubagents": {
        "type": "boolean",
        "default": false,
        "description": "Gồm cả session con (subagent)."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "default": 20,
        "description": "Số session mỗi trang."
      },
      "cursor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "description": "`nextCursor` của trang trước."
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "items",
      "nextCursor"
    ],
    "additionalProperties": false,
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "description": "Thông tin tóm tắt một session (một dòng trong danh sách).",
          "required": [
            "id",
            "projectId",
            "user",
            "agent",
            "agentVersion",
            "model",
            "repoRemote",
            "branch",
            "cwdRelative",
            "startedAt",
            "endedAt",
            "turnCount",
            "usage",
            "title",
            "parentSessionId",
            "childCount",
            "permissionMode"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "Định danh (UUID)."
            },
            "projectId": {
              "type": "string",
              "format": "uuid",
              "description": "Định danh (UUID)."
            },
            "user": {
              "type": "object",
              "description": "Thông tin rút gọn của user (dùng cho CLI).",
              "required": [
                "id",
                "email",
                "name"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Định danh (UUID)."
                },
                "email": {
                  "description": "`null` với member (không có email).",
                  "oneOf": [
                    {
                      "type": "string",
                      "format": "email"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "name": {
                  "type": "string"
                }
              }
            },
            "agent": {
              "type": "string",
              "enum": [
                "claude_code",
                "codex",
                "copilot_vscode",
                "antigravity"
              ],
              "description": "Agent sinh ra session."
            },
            "agentVersion": {
              "type": [
                "string",
                "null"
              ],
              "examples": [
                "2.1.4"
              ]
            },
            "model": {
              "type": [
                "string",
                "null"
              ],
              "description": "Model chính của session (model xuất hiện nhiều nhất ở turn của assistant); null nếu không có.",
              "examples": [
                "claude-opus-5-5"
              ]
            },
            "repoRemote": {
              "type": "string",
              "description": "Remote git đã chuẩn hóa (host/org/repo).",
              "examples": [
                "github.com/acme/shop-api"
              ]
            },
            "branch": {
              "type": [
                "string",
                "null"
              ]
            },
            "cwdRelative": {
              "type": [
                "string",
                "null"
              ],
              "description": "Thư mục làm việc tương đối với gốc repo; chuỗi rỗng là gốc repo."
            },
            "startedAt": {
              "type": "string",
              "format": "date-time"
            },
            "endedAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time",
              "description": "null khi session còn đang chạy."
            },
            "turnCount": {
              "type": "integer",
              "minimum": 0
            },
            "usage": {
              "type": "object",
              "description": "Tổng token của session (cộng từ `usage` của các turn).",
              "required": [
                "input",
                "output",
                "cacheRead",
                "cacheWrite"
              ],
              "additionalProperties": false,
              "properties": {
                "input": {
                  "type": "integer",
                  "minimum": 0
                },
                "output": {
                  "type": "integer",
                  "minimum": 0
                },
                "cacheRead": {
                  "type": "integer",
                  "minimum": 0
                },
                "cacheWrite": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "title": {
              "type": [
                "string",
                "null"
              ],
              "description": "Prompt đầu tiên của user (đã che secret), cắt còn tối đa 200 ký tự; null nếu chưa có prompt.",
              "maxLength": 200
            },
            "parentSessionId": {
              "description": "Id session cha khi đây là session con (subagent); null với session gốc hoặc khi cha chưa tới.",
              "oneOf": [
                {
                  "type": "string",
                  "format": "uuid",
                  "description": "Định danh (UUID)."
                },
                {
                  "type": "null"
                }
              ]
            },
            "childCount": {
              "type": "integer",
              "minimum": 0,
              "description": "Số session con (subagent) đã gắn vào session này."
            },
            "permissionMode": {
              "description": "Chế độ quyền của agent; null khi CLI không gửi.",
              "oneOf": [
                {
                  "type": "string",
                  "enum": [
                    "default",
                    "accept_edits",
                    "plan",
                    "bypass",
                    "unknown"
                  ],
                  "description": "Chế độ quyền của agent trong session: `default` (hỏi trước khi sửa file/chạy lệnh), `accept_edits` (tự chấp nhận sửa file), `plan` (chỉ lập kế hoạch), `bypass` (bỏ qua mọi xác nhận), `unknown` (không xác định được). Claude Code: `permissionMode`; Codex: `approval_policy` + `sandbox_policy`. Dùng cho rule `yolo-mode`."
                },
                {
                  "type": "null"
                }
              ]
            },
            "match": {
              "description": "Chỉ có khi danh sách được gọi với `q`. Turn khớp đầu tiên (theo `seq`) trong chính session này;\nnull khi session chỉ khớp qua session con. Không có trong chi tiết session.\n",
              "oneOf": [
                {
                  "type": "object",
                  "description": "Turn khớp từ khóa tìm kiếm và đoạn trích quanh từ khóa.",
                  "required": [
                    "turnSeq",
                    "snippet"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "turnSeq": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "`seq` của turn khớp; trang chi tiết có anchor `#turn-<seq>`."
                    },
                    "snippet": {
                      "type": "string",
                      "description": "Đoạn trích (văn bản đã che secret trong DB) quanh từ khóa, khoảng 8–20 từ. Từ khớp được bao bởi\n`«` và `»`; client hiển thị dạng văn bản thuần (đánh dấu phần trong «…»), không render HTML.\n",
                      "examples": [
                        "sửa lỗi «đăng» «nhập» khi token hết hạn"
                      ]
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      },
      "nextCursor": {
        "type": [
          "string",
          "null"
        ],
        "description": "Truyền vào `cursor` để lấy trang tiếp; null khi đã hết."
      }
    }
  }
}
