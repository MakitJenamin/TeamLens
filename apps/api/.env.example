# Cấu hình API TeamLens khi phát triển. Sao chép thành `.env` rồi chỉnh nếu cần.
DATABASE_URL=postgres://teamlens:teamlens@localhost:5433/teamlens
TEAMLENS_PUBLIC_URL=http://localhost:3000
# 32 byte base64, dùng mã hóa AES-GCM (LLM key...). Chỉ dùng giá trị này khi dev.
TEAMLENS_SECRET_KEY=ZGV2LW9ubHktc2VjcmV0LWtleS0zMi1ieXRlcyEhISE=
PORT=3001
# Phiên bản tl tối thiểu (GET /agent/v1/config); CLI cũ hơn ngừng gửi và báo cần cập nhật.
MIN_CLI_VERSION=0.1.0
# Job retention hằng đêm (M5.5) xóa prompt cũ hơn số ngày cài ở trang Quản trị (mặc định 90).
# DB dev có dữ liệu mẫu cũ mà muốn giữ thì bỏ dấu # dòng dưới để tắt job.
# TEAMLENS_RETENTION_JOB=off
